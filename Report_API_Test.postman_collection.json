{
  "info": {
    "name": "Report API Test",
    "description": "CveLabhub Report API 테스트 컬렉션",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 보고서 생성",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"cveId\": \"CVE-2024-1234\",\n  \"name\": \"첫 번째 테스트 보고서\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/reports",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8082",
          "path": ["api", "reports"]
        },
        "description": "새로운 보고서를 생성합니다. 응답에서 id 값을 복사하세요!"
      },
      "response": []
    },
    {
      "name": "2. 업로드 URL 받기",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/reports/1/upload",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8082",
          "path": ["api", "reports", "1", "upload"]
        },
        "description": "파일 업로드용 Presigned URL을 받습니다. 1은 보고서 ID (위에서 받은 id로 변경)"
      },
      "response": []
    },
    {
      "name": "3. 목록 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/reports?userId=1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8082",
          "path": ["api", "reports"],
          "query": [
            {
              "key": "userId",
              "value": "1"
            }
          ]
        },
        "description": "특정 사용자의 보고서 목록을 조회합니다."
      },
      "response": []
    },
    {
      "name": "4. 특정 보고서 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/reports/1?userId=1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8082",
          "path": ["api", "reports", "1"],
          "query": [
            {
              "key": "userId",
              "value": "1"
            }
          ]
        },
        "description": "특정 보고서의 상세 정보를 조회합니다."
      },
      "response": []
    },
    {
      "name": "5. 다운로드 URL 생성",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/reports/1/download?userId=1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8082",
          "path": ["api", "reports", "1", "download"],
          "query": [
            {
              "key": "userId",
              "value": "1"
            }
          ]
        },
        "description": "파일 다운로드용 Presigned URL을 생성합니다."
      },
      "response": []
    },
    {
      "name": "6. 보고서 수정",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"name\": \"수정된 보고서 제목\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/reports/1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8082",
          "path": ["api", "reports", "1"]
        },
        "description": "보고서 정보를 수정합니다. 버전이 자동으로 증가합니다."
      },
      "response": []
    },
    {
      "name": "7. CVE별 보고서 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/reports/cve/CVE-2024-1234?userId=1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8082",
          "path": ["api", "reports", "cve", "CVE-2024-1234"],
          "query": [
            {
              "key": "userId",
              "value": "1"
            }
          ]
        },
        "description": "특정 CVE ID에 대한 보고서를 조회합니다."
      },
      "response": []
    },
    {
      "name": "8. 보고서 삭제 (Soft Delete)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/reports/1?userId=1",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8082",
          "path": ["api", "reports", "1"],
          "query": [
            {
              "key": "userId",
              "value": "1"
            }
          ]
        },
        "description": "보고서를 소프트 삭제합니다. (deleted_at 필드에 시간 기록)"
      },
      "response": []
    }
  ]
}

